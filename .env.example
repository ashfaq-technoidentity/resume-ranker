# Copy to .env and fill in; docker compose reads this file automatically.
# Local dev (uvicorn + rank workflow) uses it too.

# Required for ranking (embeddings via OpenRouter)
OPENROUTER_API_KEY=

# Optional Postgres/api overrides for docker compose
# POSTGRES_USER=resume_ranker
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=resume_ranker
# API_PORT=8000
# UVICORN_WORKERS=1
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional embedding provider overrides
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional container resource limits
# API_MEM_LIMIT=2g
# API_CPUS=2
