# Copy to .env and fill in; docker compose reads this file automatically.
# Local dev (uvicorn + rank workflow) uses it too.

# Required for ranking (embeddings via OpenRouter)
OPENROUTER_API_KEY=

# Optional Postgres/api overrides for docker compose
# POSTGRES_USER=resume_ranker
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=resume_ranker
# API_PORT=8000
# UVICORN_WORKERS=1
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional embedding provider overrides
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=openai/text-embedding-3-small

# AI assistant (chat + Docker sandbox). AGENT_MODEL is any OpenRouter chat
# model; AGENT_MAX_TOKENS caps each turn (keeps OpenRouter's credit check
# small); the sandbox defaults work for local dev (docker build --target
# sandbox -t resume-ranker-sandbox . first).
# AGENT_MODEL=anthropic/claude-sonnet-4.5
# AGENT_MAX_TOKENS=4096
# AGENT_MAX_STEPS=12
# AGENT_HISTORY_MAX_MESSAGES=20
# SANDBOX_IMAGE=resume-ranker-sandbox
# SANDBOX_EXEC_TIMEOUT=120
# SANDBOX_MEM_LIMIT=1g
# SANDBOX_CPUS=1.0
# SANDBOX_PIDS_LIMIT=256
# SANDBOX_IDLE_TIMEOUT=1800
# SANDBOX_ENABLED=1

# Only needed for the compose sandbox override (docker-compose.sandbox.yml):
# the host docker group id so the api container can open the docker socket.
# DOCKER_GID=

# Optional container resource limits
# API_MEM_LIMIT=2g
# API_CPUS=2
